# ==============================================================================
# Environment Configuration Template
# WhatsApp SaaS - Multi-Tenant Appointment Booking Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & APPLICATION
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Prisma ORM)
# ------------------------------------------------------------------------------
# Option A: Local zero-dependency SQLite (default for development/testing)
DATABASE_URL="file:./dev.db"

# Option B: Docker / Staging PostgreSQL database (run `docker-compose up -d`)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/whatsapp_saas"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secure random string used to sign tenant JWT auth tokens
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"

# ------------------------------------------------------------------------------
# 4. WHATSAPP BUSINESS CLOUD API CONFIGURATION
# ------------------------------------------------------------------------------
# Set to 'true' to use the built-in simulator & in-memory mock (no Meta account needed)
# Set to 'false' to communicate with live Meta Graph WhatsApp Cloud API
WHATSAPP_USE_MOCK=true

# Meta Graph API Base URL
WHATSAPP_API_BASE_URL="https://graph.facebook.com/v20.0"

# Secret verification challenge token configured in Meta App Webhook settings
WHATSAPP_VERIFY_TOKEN="your_custom_webhook_verify_token_here"

# (Optional fallback) Meta Cloud API Access Token and Phone Number ID
# In production multi-tenant mode, these are configured per business via the WhatsApp Settings dashboard
META_WHATSAPP_TOKEN="your_meta_system_user_permanent_access_token"
META_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# In production, credentials can be set per tenant or globally via environment variables
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
PAYMENT_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# ------------------------------------------------------------------------------
# 6. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Base API URL used by the Next.js frontend client to connect to backend
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
